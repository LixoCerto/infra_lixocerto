{
  "name": "infra-lixo-certo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "smoke:grpc": "node tools/grpc-smoke.mjs --report reports/grpc-smoke.json",
    "smoke:grpc:json": "node tools/grpc-smoke.mjs --format json",
    "smoke:grpc:reflection": "node tools/grpc-reflection-smoke.mjs",
    "smoke:grpc:auth": "node tools/grpc-auth-smoke.mjs",
    "prepare:postman": "powershell -ExecutionPolicy Bypass -File scripts/preparar-postman.ps1",
    "validate:postman-proto": "node tools/validar-postman-proto.mjs",
    "validate:identity": "node tools/validar-identidade-local.mjs",
    "validate:auth-local": "node tools/validar-auth-local.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.13.4",
    "@grpc/proto-loader": "^0.7.13"
  }
}
