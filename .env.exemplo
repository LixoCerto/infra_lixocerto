# Redis local gerenciado pelo projeto de infraestrutura
REDIS_PORT=6379
REDIS_PASSWORD=alterar_senha_redis_local
REDIS_VOLUME_NAME=lcr-redis-data

# Projetos irmãos no Windows
API_CONTEXT=../api_lixocerto
FRONTEND_CONTEXT=../frontend_lixocerto
API_DOCKERFILE=../infra_lixocerto/docker/api.Dockerfile
FRONTEND_DOCKERFILE=../infra_lixocerto/docker/frontend.Dockerfile
API_ENV_FILE=../api_lixocerto/.env

# Portas publicadas somente no computador local
API_PORT=50051
GATEWAY_PORT=8080
FRONTEND_PORT=3000

# Build do frontend estático
VITE_API_BASE_URL=/api/rpc

# Ambiente da API; URL_BANCO_DADOS permanece no .env privado da API
AMBIENTE_EXECUCAO=desenvolvimento
HABILITAR_REFLECTION_GRPC=true
ORIGENS_PERMITIDAS=http://localhost:3000
SEGREDO_JWT=gerar-com-secrets-manager-com-no-minimo-32-caracteres
EMISSOR_JWT=lixo-certo-api
AUDIENCIA_JWT=lixo-certo-client

# E-mail transacional (confirmação de e-mail e recuperação de senha).
# A chave do Resend é usada exclusivamente pela API; nunca é exposta ao frontend.
# Para desenvolvimento sem enviar e-mails reais, use PROVEDOR_EMAIL=log.
PROVEDOR_EMAIL=log
RESEND_CHAVE_API=re_chave_de_api_do_resend
EMAIL_REMETENTE=nao-responda@seudominio-verificado.com
EMAIL_NOME_REMETENTE=Lixo Certo
# URL pública do frontend usada nos links enviados por e-mail.
URL_PUBLICA_FRONTEND=http://localhost:3000
