# Redis local gerenciado pelo projeto de infraestrutura
REDIS_PORT=6379
REDIS_PASSWORD=alterar_senha_redis_local
REDIS_VOLUME_NAME=lcr-redis-data

# Keycloak local para desenvolvimento; troque as senhas antes de compartilhar o arquivo .env
KEYCLOAK_PORT=8081
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=alterar_senha_admin_keycloak
KEYCLOAK_DEV_USER_USERNAME=usuario
KEYCLOAK_DEV_USER_EMAIL=usuario@lixo-certo.local
KEYCLOAK_DEV_USER_PASSWORD=alterar_senha_usuario_keycloak
KEYCLOAK_DEV_ADMIN_USERNAME=administrador
KEYCLOAK_DEV_ADMIN_EMAIL=administrador@lixo-certo.local
KEYCLOAK_DEV_ADMIN_PASSWORD=alterar_senha_administrador_keycloak
KEYCLOAK_VOLUME_NAME=lcr-keycloak-data

# Projetos irmãos no Windows
API_CONTEXT=../api_lixocerto
FRONTEND_CONTEXT=../frontend_lixocerto
API_DOCKERFILE=../infra_lixocerto/docker/api.Dockerfile
FRONTEND_DOCKERFILE=../infra_lixocerto/docker/frontend.Dockerfile
API_ENV_FILE=../api_lixocerto/.env

# Portas publicadas somente no computador local
API_PORT=50051
GATEWAY_PORT=8080
FRONTEND_PORT=3000

# Build do frontend estático
VITE_API_BASE_URL=/api/rpc
VITE_OIDC_ISSUER=http://localhost:8081/realms/lixo-certo
VITE_OIDC_CLIENT_ID=lixo-certo-frontend
VITE_OIDC_AUDIENCE=lixo-certo-api
VITE_OIDC_SCOPE=openid profile email
VITE_OIDC_REDIRECT_URI=http://localhost:3000/callback
VITE_OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:3000/login

# Ambiente da API; o URL_BANCO_DADOS permanece no .env privado da API
AMBIENTE_EXECUCAO=desenvolvimento
HABILITAR_REFLECTION_GRPC=true
ORIGENS_PERMITIDAS=http://localhost:3000

# Valores usados internamente pelo container da API; a URL JWKS deve usar o nome do serviço Docker
EMISSOR_OIDC=http://localhost:8081/realms/lixo-certo
AUDIENCIA_OIDC=lixo-certo-api
ENDERECO_JWKS=http://keycloak:8080/realms/lixo-certo/protocol/openid-connect/certs
